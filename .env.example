# Docker 部署配置（复制为 .env）
GONDAR_IMAGE=pa55w0rd01/gondar
GONDAR_TAG=0.2.0
# 应用在线更新使用构建时固定的 Pa55w0rd/Gondar GitHub Releases 与发行公钥。
POSTGRES_USER=gondar
POSTGRES_PASSWORD=change-me-please
POSTGRES_DB=gondar

# LLM（二选一或都填；也可留空到 UI 里配）
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GONDAR_LLM_PROVIDER=
GONDAR_LLM_MODEL=
GONDAR_LLM_BASE_URL=
GONDAR_LLM_PROXY=
